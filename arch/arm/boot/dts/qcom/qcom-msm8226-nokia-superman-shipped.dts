					reg = <0x800>;

					pwrkey {
						compatible = "qcom,pm8941-pwrkey";
						interrupts = <0x00 0x08 0x00 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pm8941-resin";
						interrupts = <0x00 0x08 0x01 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						status = "okay";
						linux,code = <0x72>;
					};
				};

				charger@1000 {
					compatible = "qcom,pm8226-charger";
					reg = <0x1000>;
					interrupts = <0x00 0x10 0x07 0x03 0x00 0x10 0x05 0x03 0x00 0x10 0x04 0x03 0x00 0x12 0x01 0x03 0x00 0x12 0x00 0x03 0x00 0x13 0x02 0x03 0x00 0x13 0x01 0x03 0x00 0x14 0x01 0x03>;
					interrupt-names = "chg-done", "chg-fast", "chg-trkl", "bat-temp-ok", "bat-present", "chg-gone", "usb-valid", "dc-valid";
					status = "okay";
					phandle = <0x2d>;
					io-channels = <0x42 0x06 0x42 0x30>;
					io-channel-names = "vbat", "batt-therm";
					nokia,superman-batt-thermistor;
					nokia,usb-current-policy;

					otg-vbus {
					};
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x00 0x24 0x00 0x01>;
					io-channels = <0x42 0x08>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x60>;
				};

				adc@3100 {
					compatible = "qcom,spmi-vadc";
					reg = <0x3100>;
					interrupts = <0x00 0x31 0x00 0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#io-channel-cells = <0x01>;
					phandle = <0x42>;

					channel@7 {
						reg = <0x07>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vph_pwr";
					};

					channel@8 {
						reg = <0x08>;
						label = "die_temp";
					};

					channel@9 {
						reg = <0x09>;
						label = "ref_625mv";
					};

					channel@a {
						reg = <0x0a>;
						label = "ref_1250mv";
					};

					channel@e {
						reg = <0x0e>;
					};

					channel@f {
						reg = <0x0f>;
					};

					channel@6 {
						reg = <0x06>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vbat_sns";
					};

					channel@30 {
						reg = <0x30>;
						qcom,ratiometric;
						label = "batt_therm";
					};
				};

				adc@3600 {
					compatible = "qcom,pm8226-iadc", "qcom,spmi-iadc";
					reg = <0x3600>;
					interrupts = <0x00 0x36 0x00 0x01>;
				};

				rtc@6000 {
					compatible = "qcom,pm8941-rtc";
					reg = <0x6000 0x6100>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x61 0x01 0x01>;
				};

				mpps@a000 {
					compatible = "qcom,pm8226-mpp", "qcom,spmi-mpp";
					reg = <0xa000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x43 0x00 0x00 0x08>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x43>;
				};

				gpio@c000 {
					compatible = "qcom,pm8226-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x44 0x00 0x00 0x08>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x44>;
				};
			};

			pm8226@1 {
				compatible = "qcom,pm8226", "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				regulators {
					compatible = "qcom,pm8226-regulators";
				};

				vibrator@c000 {
					compatible = "qcom,pm8916-vib";
					reg = <0xc000>;
					status = "okay";
				};
			};
		};

