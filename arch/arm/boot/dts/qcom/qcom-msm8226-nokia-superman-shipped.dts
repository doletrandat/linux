			power-domains = <0x46 0x00>;
			power-domain-names = "cx";
			clocks = <0x1b 0x00>;
			clock-names = "xo";
			memory-region = <0x57>;
			qcom,smem-states = <0x58 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";
			firmware-name = "qcom/superman/qcadsp8626.mbn";
			nokia,manual-adsp-boot;

			smd-edge {
				interrupts = <0x00 0x9c 0x01>;
				mboxes = <0x04 0x08>;
				qcom,smd-edge = <0x01>;
				label = "lpass";
			};
		};

		sram@fe805000 {
			compatible = "qcom,msm8226-imem", "syscon", "simple-mfd";
			reg = <0xfe805000 0x1000>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x65c>;
				mode-bootloader = "wfU";
				mode-normal = <0x77665501>;
				mode-recovery = <0x77665502>;
			};
		};

		remoteproc@fb204000 {
			compatible = "qcom,pronto-v1-pil", "qcom,pronto";
			reg = <0xfb204000 0x2000 0xfb202000 0x1000 0xfb21b000 0x3000>;
			reg-names = "ccu", "dxe", "pmu";
			interrupts-extended = <0x01 0x00 0x95 0x01 0x68 0x00 0x01 0x68 0x01 0x01 0x68 0x02 0x01 0x68 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			memory-region = <0x66>;
			firmware-name = "qcom/superman/wcnss.mdt";
			power-domains = <0x46 0x00>;
			power-domain-names = "cx";
			vddmx-supply = <0x6a>;
			vddpx-supply = <0x1e>;
			qcom,smem-states = <0x67 0x00>;
			qcom,smem-state-names = "stop";
			pinctrl-names = "default";
			pinctrl-0 = <0x6c>;
			phandle = <0x69>;
			status = "okay";

			iris {
				compatible = "qcom,wcn3620";
				clocks = <0x1b 0x2a>;
				clock-names = "xo";
				vddxo-supply = <0x2f>;
				vddrfa-supply = <0x6d>;
				vddpa-supply = <0x6b>;
				vdddig-supply = <0x1e>;
			};

			smd-edge {
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x8e 0x01>;
				mboxes = <0x04 0x11>;
				qcom,smd-edge = <0x06>;
				qcom,remote-pid = <0x04>;
				label = "pronto";

				wcnss {
					compatible = "qcom,wcnss";
					qcom,smd-channels = "WCNSS_CTRL";
					qcom,mmio = <0x69>;
					firmware-name = "qcom/superman/WLAN_CLPC.PROVISION";

					bluetooth {
						compatible = "qcom,wcnss-bt";
						local-bd-address = [00 00 00 00 00 02];
					};

					wifi {
						compatible = "qcom,wcnss-wlan";
						interrupt-parent = <0x01>;
						interrupts = <0x00 0x91 0x04 0x00 0x92 0x04>;
						interrupt-names = "tx", "rx";
						qcom,smem-states = <0x4c 0x0a 0x4c 0x09>;
						qcom,smem-state-names = "tx-enable", "tx-rings-empty";
						local-mac-address = [02 00 00 00 00 00];
					};
				};
			};
		};
	};

	thermal-zones {

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x59 0x05>;

			cooling-maps {

				map0 {
					trip = <0x5a>;
					cooling-device = <0x5b 0xffffffff 0xffffffff 0x5c 0xffffffff 0xffffffff 0x5d 0xffffffff 0xffffffff 0x5e 0xffffffff 0xffffffff>;
				};
			};

			trips {

				trip0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x5a>;
				};

				trip1 {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x59 0x02>;

			cooling-maps {

				map0 {
					trip = <0x5f>;
					cooling-device = <0x5b 0xffffffff 0xffffffff 0x5c 0xffffffff 0xffffffff 0x5d 0xffffffff 0xffffffff 0x5e 0xffffffff 0xffffffff>;
				};
			};

			trips {

				trip0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x5f>;
				};

				trip1 {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		pm8226-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x00>;
			thermal-sensors = <0x60>;

			trips {

				trip0 {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				crit {
					temperature = <0x23668>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	aliases {
		mmc0 = "/soc/mmc@f9824900";
		mmc1 = "/soc/mmc@f98a4900";
		display0 = "/chosen/framebuffer@3200000";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x61>;
		pinctrl-names = "default";
		label = "GPIO Buttons";

		key-volume-up {
			label = "Volume Up";
			gpios = <0x26 0x6a 0x01>;
			linux,code = <0x73>;
		};
	};

	leds {
		compatible = "gpio-leds";

		indicator {
			gpios = <0x43 0x04 0x01>;
			color = <0x00>;
			function = "indicator";
			default-state = "off";
		};

		torch {
			gpios = <0x26 0x20 0x00>;
			color = <0x00>;
			function = "torch";
			default-state = "off";
		};
	};

	firmware-display@fd900000 {
		compatible = "nokia,superman-firmware-kms";
		reg = <0xfd900000 0x23000>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x48 0x04>;
		superman,firmware-initialized;
		superman,retained-framebuffer = <0x63>;
		superman,normal-mdss = <0x4f>;
		status = "okay";
	};

	smp2p-wcnss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1c3 0x1af>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x8f 0x01>;
		mboxes = <0x04 0x12>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x04>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x67>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x68>;
		};
	};
};
