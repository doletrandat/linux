// SPDX-License-Identifier: GPL-2.0-only OR BSD-3-Clause
/*
 * Nokia Lumia 730 (superman): the device tree shipped in the Android alpha boot image ("CC60"),
 * decompiled from that image. It builds to a DTB with the same nodes and property values.
 *
 * qcom-msm8226-nokia-superman.dts is the readable source it started from. This flat file also carries
 * what was edited into the compiled tree afterwards and has not been folded back yet: Venus and its
 * IOMMU, CCI/CAMSS and both camera sensors, the 160 MiB low-memory CMA region, placeholder Wi-Fi/BT
 * addresses (replaced per phone at boot) and the kernel command line. Phandles are numeric.
 */
/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Nokia Lumia 730";
	compatible = "nokia,superman", "qcom,msm8226";
	chassis-type = "handset";

	superman-audio-board-power {
		status = "okay";
		vddio-supply = <0x71>;
		compatible = "nokia,superman-audio-board-power";
	};

	__symbols__ {
		gpu_iommu = "/soc/iommu@fdb10000";
	};

	chosen {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		stdout-path = "display0";
		bootargs = "init=/init androidboot.hardware=superman androidboot.selinux=permissive printk.devkmsg=on buildvariant=eng sdhci.debug_quirks=0x12008008 androidboot.superman_native=p34 androidboot.superman_native_stage=hwc androidboot.superman_native_sf=p48";

		framebuffer@3200000 {
			compatible = "simple-framebuffer";
			reg = <0x3200000 0x800000>;
			format = "a8r8g8b8";
			width = <0x2d0>;
			height = <0x500>;
			stride = <0xb40>;
			clocks = <0x02 0x5d 0x02 0x5e 0x02 0x5f 0x02 0x69 0x02 0x6b 0x02 0x6d>;
			power-domains = <0x02 0x01>;
			phandle = <0x63>;
		};
	};

	clocks {

		xo_board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			phandle = <0x13>;
		};

		sleep_clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x1a>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		idle-states {

			spc {
				phandle = <0x72>;
				local-timer-stop;
				min-residency-us = <0x7d0>;
				exit-latency-us = <0xc8>;
				entry-latency-us = <0x96>;
				compatible = "qcom,idle-state-spc", "arm,idle-state";
			};
		};

		cpu@0 {
			cpu-idle-states = <0x72>;
			compatible = "arm,cortex-a7";
			enable-method = "qcom,msm8226-smp";
			device_type = "cpu";
			reg = <0x00>;
			next-level-cache = <0x03>;
			clocks = <0x04>;
			operating-points-v2 = <0x05>;
			qcom,acc = <0x06>;
			qcom,saw = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x5b>;
		};

		cpu@1 {
			cpu-idle-states = <0x72>;
			compatible = "arm,cortex-a7";
			enable-method = "qcom,msm8226-smp";
			device_type = "cpu";
			reg = <0x01>;
			next-level-cache = <0x03>;
			clocks = <0x04>;
			operating-points-v2 = <0x05>;
			qcom,acc = <0x08>;
			qcom,saw = <0x09>;
			#cooling-cells = <0x02>;
			phandle = <0x5c>;
		};

		cpu@2 {
			cpu-idle-states = <0x72>;
			compatible = "arm,cortex-a7";
			enable-method = "qcom,msm8226-smp";
			device_type = "cpu";
			reg = <0x02>;
			next-level-cache = <0x03>;
			clocks = <0x04>;
			operating-points-v2 = <0x05>;
			qcom,acc = <0x0a>;
			qcom,saw = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x5d>;
		};

		cpu@3 {
			cpu-idle-states = <0x72>;
			compatible = "arm,cortex-a7";
			enable-method = "qcom,msm8226-smp";
			device_type = "cpu";
			reg = <0x03>;
			next-level-cache = <0x03>;
			clocks = <0x04>;
			operating-points-v2 = <0x05>;
			qcom,acc = <0x0c>;
			qcom,saw = <0x0d>;
			#cooling-cells = <0x02>;
			phandle = <0x5e>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x03>;
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-msm8226", "qcom,scm";
			clocks = <0x0e 0x8e 0x0e 0x8d 0x0e 0x8c>;
			clock-names = "core", "bus", "iface";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00>;
	};

	opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x05>;

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
		};

		opp-384000000 {
			opp-hz = <0x00 0x16e36000>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
		};

		opp-787200000 {
			opp-hz = <0x00 0x2eebb800>;
		};
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	remoteproc {
		compatible = "qcom,msm8226-rpm-proc", "qcom,rpm-proc";

		master-stats {
			compatible = "qcom,rpm-master-stats";
			qcom,rpm-msg-ram = <0x0f 0x10 0x11 0x12>;
			qcom,master-names = "APSS", "MPSS", "LPSS", "PRONTO";
		};

		smd-edge {
			interrupts = <0x00 0xa8 0x01>;
			mboxes = <0x04 0x00>;
			qcom,smd-edge = <0x0f>;

			rpm-requests {
				compatible = "qcom,rpm-msm8226", "qcom,smd-rpm";
				qcom,smd-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-msm8226", "qcom,rpmcc";
					#clock-cells = <0x01>;
					clocks = <0x13>;
					clock-names = "xo";
					phandle = <0x1b>;
				};

				power-controller {
					compatible = "qcom,msm8226-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x14>;
					phandle = <0x46>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x14>;

						opp1 {
							opp-level = <0x01>;
						};

						opp2 {
							opp-level = <0x02>;
						};

						opp3 {
							opp-level = <0x03>;
						};

						opp4 {
							phandle = <0x6e>;
							opp-level = <0x04>;
						};

						opp5 {
							opp-level = <0x05>;
						};

						opp6 {
							phandle = <0x6f>;
							opp-level = <0x06>;
						};
					};
				};

				regulators {
					compatible = "qcom,rpm-pm8226-regulators";

					lvs1 {
						phandle = <0x81>;
					};

					s1 {
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
					};

					s3 {
						regulator-min-microvolt = <0x13d620>;
						regulator-max-microvolt = <0x13d620>;
					};

					s4 {
						regulator-allow-set-load;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x200b20>;
						phandle = <0x64>;
					};

					s5 {
						regulator-min-microvolt = <0x118c30>;
						regulator-max-microvolt = <0x118c30>;
					};

					l3 {
						regulator-min-microvolt = <0xb71b0>;
						regulator-max-microvolt = <0x118c30>;
						phandle = <0x6a>;
					};

					l4 {
						phandle = <0x73>;
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
					};

					l5 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
					};

					l6 {
						regulator-allow-set-load;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x1e>;
					};

					l7 {
						regulator-min-microvolt = <0x1c3a90>;
						regulator-max-microvolt = <0x1c3a90>;
					};

					l8 {
						phandle = <0x70>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
					};

					l9 {
						regulator-min-microvolt = <0x1f47d0>;
						regulator-max-microvolt = <0x1f47d0>;
					};

					l10 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x2f>;
					};

					l12 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l14 {
						regulator-min-microvolt = <0x29f630>;
						regulator-max-microvolt = <0x29f630>;
					};

					l15 {
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2b7cd0>;
						phandle = <0x25>;
					};

					l16 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
						phandle = <0x6b>;
					};

					l17 {
						regulator-min-microvolt = <0x2d0370>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-system-load = <0x30d40>;
						regulator-allow-set-load;
						phandle = <0x1d>;
					};

					l18 {
						regulator-min-microvolt = <0x2d0370>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-system-load = <0x30d40>;
						regulator-allow-set-load;
						phandle = <0x21>;
					};

					l19 {
						phandle = <0x80>;
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2b7cd0>;
					};

					l20 {
						regulator-min-microvolt = <0x2eebb8>;
						regulator-max-microvolt = <0x2eebb8>;
						phandle = <0x30>;
					};

					l21 {
						regulator-min-microvolt = <0x1c3a90>;
						regulator-max-microvolt = <0x2d0370>;
						phandle = <0x22>;
					};

					l22 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l23 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l24 {
						regulator-min-microvolt = <0x13d620>;
						regulator-max-microvolt = <0x13d620>;
						phandle = <0x6d>;
					};

					l25 {
						phandle = <0x71>;
						regulator-min-microvolt = <0x1b1598>;
						regulator-max-microvolt = <0x1fa978>;
					};

					l27 {
						regulator-min-microvolt = <0x1f47d0>;
						regulator-max-microvolt = <0x1f47d0>;
					};

					l28 {
						regulator-min-microvolt = <0x1e8480>;
						regulator-max-microvolt = <0x2dc6c0>;
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		linux,cma {
			alloc-ranges = <0x10000000 0x20000000>;
			linux,cma-default;
			size = <0xa000000>;
			reusable;
			compatible = "shared-dma-pool";
		};

		venus@f500000 {
			phandle = <0x76>;
			no-map;
			reg = <0xf000000 0x500000>;
		};

		rmtfs@fd80000 {
			no-map;
			qcom,client-id = <0x01>;
			reg = <0xfd80000 0x180000>;
			compatible = "qcom,rmtfs-mem";
		};

		diagnostic-quarantine@ff00000 {
			no-map;
			reg = <0xff00000 0x100000>;
		};

		diagnostic-quarantine@f500000 {
			no-map;
			reg = <0xf500000 0x880000>;
		};

		mpss@8000000 {
			reg = <0x8000000 0x5100000>;
			no-map;
			status = "okay";
			phandle = <0x4a>;
		};

		mba@d100000 {
			reg = <0xd100000 0x100000>;
			no-map;
			status = "okay";
			phandle = <0x49>;
		};

		adsp@dc00000 {
			reg = <0xdc00000 0x1900000>;
			no-map;
			phandle = <0x57>;
		};

		framebuffer@3200000 {
			reg = <0x3200000 0x800000>;
			no-map;
		};

		smem@fa00000 {
			reg = <0xfa00000 0x100000>;
			no-map;
			phandle = <0x15>;
		};

		wcnss@d200000 {
			reg = <0xd200000 0xa00000>;
			no-map;
			phandle = <0x66>;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <0x15>;
		qcom,rpm-msg-ram = <0x16>;
		hwlocks = <0x17 0x03>;
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x9e 0x01>;
		mboxes = <0x04 0x0a>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x58>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x56>;
		};
	};

	smp2p-modem {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x1b 0x01>;
		mboxes = <0x04 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x48>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x45>;
		};
	};

	smsm {
		compatible = "qcom,smsm";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		mboxes = <0x00 0x04 0x0d 0x04 0x09 0x04 0x13>;

		apps@0 {
			reg = <0x00>;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x4c>;
		};

		modem@1 {
			reg = <0x01>;
			interrupts = <0x00 0x1a 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x4b>;
		};

		adsp@2 {
			reg = <0x02>;
			interrupts = <0x00 0x9d 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		wcnss@7 {
			reg = <0x07>;
			interrupts = <0x00 0x90 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		camss@fda00000 {
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			vdda-supply = <0x73>;
			clock-names = "top_ahb", "ispif_ahb", "csiphy0_timer", "csiphy1_timer", "csi0_ahb", "csi0", "csi0_phy", "csi0_pix", "csi0_rdi", "csi1_ahb", "csi1", "csi1_phy", "csi1_pix", "csi1_rdi", "vfe0", "csi_vfe0", "vfe_ahb", "vfe_axi";
			clocks = <0x02 0x55 0x02 0x46 0x02 0x52 0x02 0x53 0x02 0x2e 0x02 0x2f 0x02 0x30 0x02 0x31 0x02 0x32 0x02 0x33 0x02 0x34 0x02 0x35 0x02 0x36 0x02 0x37 0x02 0x58 0x02 0x42 0x02 0x5a 0x02 0x5b>;
			power-domains = <0x02 0x03>;
			interrupt-names = "csiphy0", "csiphy1", "csid0", "csid1", "ispif", "vfe0";
			interrupts = <0x00 0x4e 0x01 0x00 0x4f 0x01 0x00 0x33 0x01 0x00 0x34 0x01 0x00 0x37 0x01 0x00 0x39 0x01>;
			reg-names = "csiphy0", "csiphy0_clk_mux", "csiphy1", "csiphy1_clk_mux", "csid0", "csid1", "ispif", "csi_clk_mux", "vfe0";
			reg = <0xfda0ac00 0x200 0xfda00030 0x04 0xfda0b000 0x200 0xfda00038 0x04 0xfda08000 0x100 0xfda08400 0x100 0xfda0a000 0x500 0xfda00020 0x10 0xfda10000 0x1000>;
			compatible = "qcom,msm8226-camss";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@1 {
					reg = <0x01>;

					endpoint {
						clock-lanes = <0x01>;
						data-lanes = <0x00>;
						remote-endpoint = <0x87>;
						phandle = <0x88>;
					};
				};

				port@0 {
					reg = <0x00>;

					endpoint {
						clock-lanes = <0x01>;
						data-lanes = <0x00 0x02>;
						remote-endpoint = <0x84>;
						phandle = <0x85>;
					};
				};
			};
		};

		video-codec@fdc00000 {
			memory-region = <0x76>;
			iommus = <0x77 0x00>;
			clock-names = "core", "iface", "bus";
			clocks = <0x02 0x7d 0x02 0x7a 0x02 0x7b>;
			interrupts = <0x00 0x2c 0x04>;
			interrupt-parent = <0x01>;
			reg = <0xfdc00000 0xff000>;
			compatible = "qcom,msm8226-venus";

			video-encoder {
				compatible = "venus-encoder";
			};

			video-decoder {
				compatible = "venus-decoder";
			};
		};

		iommu@fdc84000 {
			resets = <0x02 0x02>;
			reg = <0xfdc84000 0x2600>;
			phandle = <0x77>;
			interrupt-parent = <0x01>;
			clock-names = "iface", "bus", "tbu";
			clocks = <0x02 0x7a 0x02 0x7b 0x02 0x7d>;
			qcom,iommu-secure-id = <0x00>;
			ranges = <0x00 0xfdc8c000 0x3000>;
			#iommu-cells = <0x01>;
			#size-cells = <0x01>;
			#address-cells = <0x01>;
			compatible = "qcom,msm8226-venus-iommu";

			iommu-ctx@2000 {
				interrupts = <0x00 0x2a 0x04 0x00 0x2b 0x04>;
				reg = <0x2000 0x1000>;
				compatible = "qcom,msm-iommu-v1-sec";
			};

			iommu-ctx@1000 {
				interrupts = <0x00 0x2a 0x04 0x00 0x2b 0x04>;
				reg = <0x1000 0x1000>;
				compatible = "qcom,msm-iommu-v1-sec";
			};

			iommu-ctx@0 {
				interrupts = <0x00 0x2a 0x04>;
				reg = <0x00 0x1000>;
				compatible = "qcom,msm-iommu-v1-ns";
			};
		};

		iommu@fdb10000 {
			phandle = <0x62>;
			status = "okay";
			interrupt-parent = <0x01>;
			power-domains = <0x02 0x05>;
			clock-names = "iface", "bus", "tbu";
			clocks = <0x02 0x78 0x02 0x79 0x02 0x77>;
			ranges = <0x00 0xfdb18000 0x2000>;
			#iommu-cells = <0x01>;
			#size-cells = <0x01>;
			#address-cells = <0x01>;
			reg = <0xfdb10000 0x2600>;
			compatible = "qcom,msm8226-gpu-iommu";

			iommu-ctx@1000 {
				interrupts = <0x00 0xf1 0x04>;
				reg = <0x1000 0x1000>;
				compatible = "qcom,msm-iommu-v1-ns";
			};

			iommu-ctx@0 {
				interrupts = <0x00 0xf1 0x04>;
				reg = <0x00 0x1000>;
				compatible = "qcom,msm-iommu-v1-ns";
			};
		};

		interrupt-controller@f9000000 {
			compatible = "qcom,msm-qgic2";
			reg = <0xf9000000 0x1000 0xf9002000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			phandle = <0x01>;
		};

		mailbox@f9011000 {
